{
  "name": "sis2-playwright-toolshop",
  "version": "1.0.0",
  "description": "SIS 2 – Playwright test automation for Practice Software Testing (Toolshop)",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:auth": "playwright test --grep @auth",
    "test:catalog": "playwright test --grep @catalog",
    "test:cart": "playwright test --grep @cart",
    "test:checkout": "playwright test --grep @checkout",
    "test:api": "playwright test --grep @api",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "test-automation",
    "sis2",
    "e2e"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
